# Copy to .env.local for local dev. NEVER commit real secrets.
# On Vercel: paste the real values under Project -> Settings -> Environment Variables.

# Pooled connection (transaction mode, IPv4) - used by the app at runtime
DATABASE_URL="postgresql://postgres.ttonaokqzuvkblouxvbh:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (session mode) - used for prisma migrate/seed
DIRECT_URL="postgresql://postgres.ttonaokqzuvkblouxvbh:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# Admin CMS access (password gate for /admin). Set a strong value on Vercel.
ADMIN_PASSWORD="[YOUR-ADMIN-PASSWORD]"

# Used by `npx prisma db seed` to create the initial SUPER_ADMIN user row
SEED_ADMIN_EMAIL="admin@gombe-summit.ng"
SEED_ADMIN_NAME="Summit Administrator"

# Resend branded email (server-side only). Get a key at resend.com/api-keys,
# verify your sending domain/subdomain there, then set the real values on Vercel.
RESEND_API_KEY="[YOUR-RESEND-API-KEY]"
RESEND_FROM="Gombe Summit <updates@gombestateaidsummit.ng>"

# Svix-signed webhook secret for Resend inbound email (Resend dashboard -> Webhooks).
# The app exposes POST /api/email/inbound - point the Resend receiving route there.
RESEND_WEBHOOK_SECRET="[YOUR-RESEND-WEBHOOK-SECRET]"

# Supabase service key (SERVER-ONLY, never expose to the browser).
# Used for storage uploads + signed admin download links.
SUPABASE_URL="https://ttonaokqzuvkblouxvbh.supabase.co"
SUPABASE_SERVICE_KEY="[YOUR-SUPABASE-SERVICE-KEY]"
